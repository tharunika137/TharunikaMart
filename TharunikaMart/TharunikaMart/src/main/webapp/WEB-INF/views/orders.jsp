<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="static com.tharunika.tharunikamart.util.ValidationUtil.esc" %>
<%@ include file="header.jsp" %><div class="section-head"><div><div class="eyebrow">Purchase history</div><h1>Your orders</h1></div></div><div class="list-card"><%for(com.tharunika.tharunikamart.model.OrderSummary o:(java.util.List<com.tharunika.tharunikamart.model.OrderSummary>)request.getAttribute("orders")){%><div class="order-row"><div><b>Order #<%=o.id()%></b><span><%=o.createdAt()%></span><span class="muted"><%=esc(o.paymentMethod())%> · <%=esc(o.shippingAddress())%></span></div><span class="status <%=o.status().toLowerCase()%>"><%=o.status()%></span><strong>₹<%=o.totalAmount()%></strong><% if("PENDING".equals(o.status())){%><form method="post" action="<%=ctx%>/app/orders/cancel" data-confirm-cancel="true"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=o.id()%>"><button class="danger-link">Cancel</button></form><%}%></div><%}%></div><%@ include file="footer.jsp" %>
