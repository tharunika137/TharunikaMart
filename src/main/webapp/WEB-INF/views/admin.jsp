<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="static com.tharunika.tharunikamart.util.ValidationUtil.esc" %>
<%@ include file="header.jsp" %>
<div class="admin-grid"><div class="list-card"><h2>Users</h2><%for(com.tharunika.tharunikamart.model.User u:(java.util.List<com.tharunika.tharunikamart.model.User>)request.getAttribute("users")){%><div class="seller-row"><div><b><%=esc(u.name())%></b><span><%=esc(u.email())%></span></div><span class="tag"><%=u.role()%></span></div><%}%></div><div class="list-card"><h2>Orders</h2><%for(com.tharunika.tharunikamart.model.OrderSummary o:(java.util.List<com.tharunika.tharunikamart.model.OrderSummary>)request.getAttribute("orders")){%><div class="order-row"><div><b>#<%=o.id()%> · <%=esc(o.buyerName())%></b><span>₹<%=o.totalAmount()%></span></div><form method="post" action="<%=ctx%>/app/admin/order/status"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=o.id()%>"><select name="status" onchange="this.form.submit()"><%for(String st:new String[]{"PENDING","CONFIRMED","SHIPPED","DELIVERED","CANCELLED"}){%><option <%=st.equals(o.status())?"selected":""%>><%=st%></option><%}%></select></form></div><%}%></div></div>
<div class="list-card"><h2>Listings moderation</h2><%for(com.tharunika.tharunikamart.model.Product p:(java.util.List<com.tharunika.tharunikamart.model.Product>)request.getAttribute("products")){%><div class="seller-row"><div><b><%=esc(p.name())%></b><span>Seller: <%=esc(p.sellerName())%> · ₹<%=p.price()%><%=p.isRental()?"/day":""%> · <%=p.isRental()?"Rental":"Sale"%></span></div><form method="post" action="<%=ctx%>/app/admin/product/delete"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=p.id()%>"><button class="danger-link">Remove</button></form></div><%}%></div><%@ include file="footer.jsp" %>
