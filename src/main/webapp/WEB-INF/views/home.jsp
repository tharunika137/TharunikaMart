<%@ include file="header.jsp" %>
<section class="hero"><div><div class="eyebrow">Campus marketplace</div><h1>Buy smarter.<br><em>Sell beautifully.</em></h1><p>Discover useful products from independent sellers in one polished marketplace.</p><div class="hero-actions"><a class="btn" href="#products">Explore products</a><a class="btn btn-ghost" href="<%=ctx%>/app/register">Become a seller</a></div></div><div class="hero-card"><div class="hero-icon">✦</div><b>One marketplace.</b><span>Buyer · Seller · Admin</span><small>Secure sessions · BCrypt · JDBC</small></div></section>
<section class="toolbar"><form method="get" action="<%=ctx%>/app/home" class="search"><input name="q" placeholder="Search products..." value="<%=request.getParameter("q")==null?"":request.getParameter("q")%>"><select name="category"><option value="">All categories</option><option>Electronics</option><option>Lifestyle</option><option>Home</option></select><button class="btn btn-small">Search</button></form></section>
<section id="products"><div class="section-head"><div><div class="eyebrow">Featured collection</div><h2>Fresh finds</h2></div><span class="muted"><%=((java.util.List)request.getAttribute("products")).size()%> products</span></div>
<div class="grid">
<% for(Object o:(java.util.List)request.getAttribute("products")){ com.tharunika.tharunikamart.model.Product p=(com.tharunika.tharunikamart.model.Product)o; %>
<article class="product-card"><div class="product-img"><img src="<%=p.imageUrl()==null||p.imageUrl().isBlank()?ctx+"/assets/img/placeholder.svg":p.imageUrl()%>" alt="<%=p.name()%>"></div><div class="product-body"><span class="tag"><%=p.category()%></span><h3><%=p.name()%></h3><p><%=p.description()%></p><div class="product-meta"><strong>₹<%=p.price()%></strong><span><%=p.stockQty()%> in stock</span></div><% if(current!=null&&"BUYER".equals(current.role())&&p.stockQty()>0){%><form method="post" action="<%=ctx%>/app/cart/add"><input type="hidden" name="productId" value="<%=p.id()%>"><input type="hidden" name="quantity" value="1"><button class="btn full">Add to cart</button></form><%}else if(current==null){%><a class="btn full" href="<%=ctx%>/app/login">Login to buy</a><%}%></div></article>
<% } %></div></section><%@ include file="footer.jsp" %>
