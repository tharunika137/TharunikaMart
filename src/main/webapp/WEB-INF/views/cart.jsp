<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="static com.tharunika.tharunikamart.util.ValidationUtil.esc" %>
<%@ page import="static com.tharunika.tharunikamart.util.ValidationUtil.imageSrc" %>
<%@ include file="header.jsp" %>
<% java.util.List<com.tharunika.tharunikamart.model.CartItem> items=(java.util.List<com.tharunika.tharunikamart.model.CartItem>)request.getAttribute("items"); %>
<% if(items.isEmpty()){%><div class="empty"><div class="empty-icon">🛒</div><h2>Your cart is empty</h2><p>Add something you love from the marketplace.</p><a class="btn" href="<%=ctx%>/app/home">Browse products</a></div><%}else{%><div class="cart-layout"><div class="list-card"><%for(com.tharunika.tharunikamart.model.CartItem i:items){%><div class="cart-row"><img src="<%=imageSrc(i.imageUrl(),ctx)%>" alt=""><div class="cart-info"><h3><%=esc(i.productName())%></h3><span>₹<%=i.unitPrice()%> each</span></div><form method="post" action="<%=ctx%>/app/cart/update" class="qty"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="productId" value="<%=i.productId()%>"><input name="quantity" type="number" min="1" max="<%=i.stockQty()%>" value="<%=i.quantity()%>"><button>Update</button></form><strong>₹<%=i.total()%></strong><form method="post" action="<%=ctx%>/app/cart/remove"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="productId" value="<%=i.productId()%>"><button class="icon-btn">×</button></form></div><%}%></div><aside class="summary"><span>Order total</span><strong>₹<%=request.getAttribute("total")%></strong><a class="btn full" href="<%=ctx%>/app/checkout">Proceed to checkout</a></aside></div><%}%><%@ include file="footer.jsp" %>
