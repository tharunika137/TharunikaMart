<%@ include file="header.jsp" %><div class="section-head"><div><div class="eyebrow">Your bag</div><h1>Shopping cart</h1></div></div><% java.util.List<com.tharunika.tharunikamart.model.CartItem> items=(java.util.List<com.tharunika.tharunikamart.model.CartItem>)request.getAttribute("items"); %>
<% if(items.isEmpty()){%><div class="empty"><div class="empty-icon">🛒</div><h2>Your cart is empty</h2><p>Add something you love from the marketplace.</p><a class="btn" href="<%=ctx%>/app/home">Browse products</a></div><%}else{%><div class="cart-layout"><div class="list-card"><%for(var i:items){%><div class="cart-row"><img src="<%=i.imageUrl()%>" alt=""><div class="cart-info"><h3><%=i.productName()%></h3><span>₹<%=i.unitPrice()%> each</span></div><form method="post" action="<%=ctx%>/app/cart/update" class="qty"><input type="hidden" name="productId" value="<%=i.productId()%>"><input name="quantity" type="number" min="1" max="<%=i.stockQty()%>" value="<%=i.quantity()%>"><button>Update</button></form><strong>₹<%=i.total()%></strong><form method="post" action="<%=ctx%>/app/cart/remove"><input type="hidden" name="productId" value="<%=i.productId()%>"><button class="icon-btn">×</button></form></div><%}%></div><aside class="summary"><span>Order total</span><strong>₹<%=request.getAttribute("total")%></strong><p>Mock payment confirmation is used for this capstone.</p><form method="post" action="<%=ctx%>/app/checkout"><button class="btn full">Confirm & place order</button></form></aside></div><%}%><%@ include file="footer.jsp" %>
