<%@ include file="header.jsp" %><div class="auth-shell single"><div class="auth-card wide"><div class="eyebrow">Join the marketplace</div><h1>Create your account</h1><p class="muted">Register as a Buyer or Seller. Administrator accounts are seeded for secure management.</p><% if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%>
<form method="post" action="<%=ctx%>/app/register" class="form-grid"><label>Full name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Password<input name="password" type="password" minlength="6" required></label><label>Account type<select name="role"><option value="BUYER">Buyer</option><option value="SELLER">Seller</option></select></label><button class="btn full">Create account</button></form><p class="auth-foot">Already registered? <a href="<%=ctx%>/app/login">Log in</a></p></div></div><%@ include file="footer.jsp" %>
