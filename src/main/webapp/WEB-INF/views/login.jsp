<%@ include file="header.jsp" %><div class="auth-shell"><div class="auth-art"><div class="eyebrow">Welcome back</div><h1>Everything you need.<br><em>One account away.</em></h1><p>Choose your workspace and continue to TharunikaMart.</p><div class="role-mini"><span>●</span> Buyer shopping</div><div class="role-mini"><span>●</span> Seller studio</div><div class="role-mini"><span>●</span> Admin control</div></div>
<div class="auth-card"><div class="tabs"><button type="button" class="tab active" data-role="BUYER">Buyer</button><button type="button" class="tab" data-role="SELLER">Seller</button><button type="button" class="tab" data-role="ADMIN">Administrator</button></div>
<% if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><% if(request.getAttribute("success")!=null){%><div class="alert success"><%=request.getAttribute("success")%></div><%}%>
<form method="post" action="<%=ctx%>/app/login" id="loginForm"><input type="hidden" name="role" id="role" value="BUYER"><label>Email<input name="email" type="email" required placeholder="you@example.com"></label><label>Password<input name="password" type="password" required placeholder="••••••••"></label><button class="btn full">Continue as <span id="roleText">Buyer</span> →</button></form>
<div class="demo-box"><b>Demo accounts</b><div>Buyer: buyer@tharunikamart.local / password</div><div>Seller: seller@tharunikamart.local / password</div><div>Admin: admin@tharunikamart.local / password</div></div>
<p class="auth-foot">New here? <a href="<%=ctx%>/app/register">Create an account</a></p></div></div><%@ include file="footer.jsp" %>
