<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="static com.tharunika.tharunikamart.util.ValidationUtil.esc" %>
<%@ include file="header.jsp" %>
<div class="studio-grid"><div class="form-card"><h2>Add product</h2><form method="post" action="<%=ctx%>/app/seller/product/save"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="0"><label>Product name<input name="name" required></label><label>Description<textarea name="description" required></textarea></label><div class="form-grid"><label>Price<input name="price" type="number" step=".01" min="0" required></label><label>Stock<input name="stock" type="number" min="0" required></label></div><label>Category<input name="category" required></label><label>Image URL<input name="image"></label><label>Listing type<select name="listingType"><option value="SALE">For sale</option><option value="RENT">For rent (price = per day)</option></select></label><button class="btn full">Publish listing</button></form></div><div class="list-card"><h2>Your listings</h2><%for(com.tharunika.tharunikamart.model.Product p:(java.util.List<com.tharunika.tharunikamart.model.Product>)request.getAttribute("products")){%><div class="seller-row"><div><b><%=esc(p.name())%></b><span><%=esc(p.category())%> · ₹<%=p.price()%><%=p.isRental()?"/day":""%> · <%=p.stockQty()%> stock · <%=p.isRental()?"Rental":"Sale"%></span></div><form method="post" action="<%=ctx%>/app/seller/product/delete"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=p.id()%>"><button class="danger-link">Delete</button></form></div><%}%></div></div><%@ include file="footer.jsp" %>
