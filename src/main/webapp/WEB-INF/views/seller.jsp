<%@ include file="header.jsp" %><div class="section-head"><div><div class="eyebrow">Seller studio</div><h1>Manage listings</h1><p class="muted">Create, edit and remove your product listings.</p></div></div>
<div class="studio-grid"><div class="form-card"><h2>Add product</h2><form method="post" action="<%=ctx%>/app/seller/product/save"><input type="hidden" name="id" value="0"><label>Product name<input name="name" required></label><label>Description<textarea name="description" required></textarea></label><div class="form-grid"><label>Price<input name="price" type="number" step=".01" min="0" required></label><label>Stock<input name="stock" type="number" min="0" required></label></div><label>Category<input name="category" required></label><label>Image URL<input name="image"></label><button class="btn full">Publish listing</button></form></div><div class="list-card"><h2>Your listings</h2><%for(com.tharunika.tharunikamart.model.Product p:(java.util.List<com.tharunika.tharunikamart.model.Product>)request.getAttribute("products")){%><div class="seller-row"><div><b><%=p.name()%></b><span><%=p.category()%> · ₹<%=p.price()%> · <%=p.stockQty()%> stock</span></div><form method="post" action="<%=ctx%>/app/seller/product/delete"><input type="hidden" name="id" value="<%=p.id()%>"><button class="danger-link">Delete</button></form></div><%}%></div></div><%@ include file="footer.jsp" %>
