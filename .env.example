# Local default uses embedded H2 automatically.
# For cloud deployment, set the JDBC URL in the runtime environment instead of hard-coding local values.
# Example PostgreSQL settings:
# THARUNIKA_DB_URL=jdbc:postgresql://host:5432/tharunikamart
# THARUNIKA_DB_USER=tharunikamart
# THARUNIKA_DB_PASSWORD=change-me
#
# Optional local override:
# -Dtharunikamart.db=jdbc:h2:./data/tharunikamart;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
AI_CHATBOT_PROVIDER=mock
